# Torii — environment template. Copy to infra/compose/.env and edit before `docker compose up`.
# Never commit the real .env (see .gitignore). Secrets come from the secret store in production.

# --- Image registry / tag (CI builds and pushes; the host only pulls) ---------
IMAGE_OWNER=your-org
TAG=latest

# --- PostgreSQL 17 + pgvector (read by the postgres image itself) -------------
POSTGRES_USER=torii
POSTGRES_PASSWORD=change-me
POSTGRES_DB=torii

# --- API (torii_api, TORII_ prefix) -------------------------------------------
# Points at the compose `postgres` service on the private `data` network.
TORII_DATABASE_URL=postgresql://torii:change-me@postgres:5432/torii
# Apply Alembic migrations on API startup inside the container.
TORII_MIGRATE_ON_STARTUP=true
# arq queue + cron broker (the compose `redis` service).
TORII_REDIS_URL=redis://redis:6379/0
TORII_LOG_LEVEL=INFO
# Dev-only default; set a strong random value in production.
TORII_JWT_SECRET_KEY=change-me-in-production

# --- SMTP (email delivery — verification, password reset) --------------------
# Leave TORII_SMTP_HOST empty to disable email sending (logs the link in dev).
TORII_SMTP_HOST=
TORII_SMTP_PORT=587
TORII_SMTP_USER=
TORII_SMTP_PASSWORD=
TORII_SMTP_FROM_EMAIL=noreply@torii.app
TORII_SMTP_FROM_NAME=Torii
TORII_SMTP_TLS=true
# Base URL for building email verification / reset links (your frontend URL).
TORII_APP_BASE_URL=http://localhost:3000

# --- Web (Next.js) ------------------------------------------------------------
# Server-side (RSC) API base — the internal `edge`-network address of the api service.
API_INTERNAL_BASE_URL=http://api:8000

# --- Edge ---------------------------------------------------------------------
# Host port nginx publishes (only nginx is exposed to the host).
NGINX_HTTP_PORT=8080
