# Torii — environment template. Copy to infra/compose/.env and edit before `docker compose up`.
# Never commit the real .env (see .gitignore). Secrets come from the secret store in production.

# --- Image registry / tag ------------------------------------------------------
# .github/workflows/deploy.yml builds and pushes ghcr.io/<owner>/torii-{api,ai,web}, then
# rewrites these two lines on the host before `docker compose up`. Set them by hand only when
# running the stack outside CI.
IMAGE_OWNER=noruvalabs
TAG=latest

# --- Stack identity ------------------------------------------------------------
# Overrides the compose file's `name:`, which namespaces containers AND volumes. Change it
# (e.g. torii-staging) when a host runs more than one Torii stack, so staging does not share
# production's database.
COMPOSE_PROJECT_NAME=torii

# --- Server SSH Deployment Credentials (used by GitHub Actions) ---------------
# Can be placed here in .env (if pushed via DEPLOY_ENV_FILE_B64) or set as GitHub Secrets
DEPLOY_SSH_HOST=
DEPLOY_SSH_USER=
DEPLOY_SSH_KEY=
DEPLOY_SSH_PORT=22

# --- PostgreSQL 17 + pgvector (read by the postgres image itself) -------------
POSTGRES_USER=torii
POSTGRES_PASSWORD=change-me
POSTGRES_DB=torii

# --- API (torii_api, TORII_ prefix) -------------------------------------------
# Points at the compose `postgres` service on the private `data` network.
TORII_DATABASE_URL=postgresql://torii:change-me@postgres:5432/torii
# Apply Alembic migrations on API startup inside the container.
TORII_MIGRATE_ON_STARTUP=true
# Seed jurisdictions, visa categories, and workflows on API startup.
TORII_SEED_ON_STARTUP=true
# Seed sample demo users (admin@example.com etc.). Leave false for staging/production.
TORII_SEED_DEMO_USERS=false
# arq queue + cron broker (the compose `redis` service).
TORII_REDIS_URL=redis://redis:6379/0
TORII_LOG_LEVEL=INFO
# Dev-only default; set a strong random value in production.
TORII_JWT_SECRET_KEY=change-me-in-production

# --- Superuser / Admin Bootstrap (auto-created on startup, no demo seed needed)
# Set these to automatically create the initial admin user without running demo seed.
TORII_SUPERUSER_EMAIL=
TORII_SUPERUSER_PASSWORD=

# --- SMTP (email delivery — verification, password reset) --------------------
# Leave TORII_SMTP_HOST empty to disable email sending (logs the link in dev).
TORII_SMTP_HOST=
TORII_SMTP_PORT=587
TORII_SMTP_USER=
TORII_SMTP_PASSWORD=
TORII_SMTP_FROM_EMAIL=noreply@torii.app
TORII_SMTP_FROM_NAME=Torii
TORII_SMTP_TLS=true
# Base URL for building email verification / reset links — your PUBLIC site URL.
TORII_APP_BASE_URL=https://torii.example.com

# The api and the worker call the ai service here (scraper cron, stage research, eligibility).
# The default is localhost:8001, which is wrong inside a container — set it explicitly.
TORII_AI_SERVICE_URL=http://ai:8001
# Jurisdiction codes the daily scraper covers.
TORII_SCRAPE_JURISDICTIONS=JP

# --- Web (Next.js) ------------------------------------------------------------
# Server-side (RSC) API base — the internal `edge`-network address of the api service.
API_INTERNAL_BASE_URL=http://api:8000

# --- AI service (torii_ai, TORII_AI_ prefix) -----------------------------------
# Read by the compose `ai` service (nginx routes /assistant/* to it). Provider keys are real
# secrets — they belong in the secret store, never in a committed file.
TORII_AI_LOG_LEVEL=INFO
# Scalar /docs on a public edge; leave off in production.
TORII_AI_DOCS_ENABLED=false
# NVIDIA NIM is preferred when set, then Groq. Groq retires model names on its own schedule —
# a retired name answers 404 model_not_found rather than degrading.
TORII_AI_NVIDIA_API_KEY=
TORII_AI_NVIDIA_MODEL=openai/gpt-oss-120b
TORII_AI_GROQ_API_KEY=
TORII_AI_GROQ_MODEL=qwen/qwen3.6-27b
TORII_AI_GROQ_EXTRACT_MODEL=openai/gpt-oss-120b
TORII_AI_GROQ_BASE_URL=https://api.groq.com/openai/v1
TORII_AI_TAVILY_API_KEY=
# System of record, on the private `edge` network (overridden in compose, kept here so the
# file stands alone).
TORII_AI_API_BASE_URL=http://api:8000
# Sent as `Authorization: Bearer <this>` when the ai service writes scraped proposals back to
# /v1/admin/ops/*. Those routes require a real ADMIN/OPS user, so this must be a JWT issued
# for an ops account — not an arbitrary shared secret. Leave empty to disable write-back.
TORII_AI_SERVICE_TOKEN=
# Behind TLS in production, so the session cookie must be Secure.
TORII_AI_COOKIE_SECURE=true

# --- Edge ---------------------------------------------------------------------
# Host port nginx publishes (only nginx is exposed to the host). Terminate TLS in front of
# this — a host reverse proxy or a load balancer — and forward to 127.0.0.1:<this port>.
NGINX_HTTP_PORT=8080
