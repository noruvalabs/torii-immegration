# Torii — single local-dev environment file for the whole monorepo.
# Copy to `.env` at the repo root and fill in secrets. All three apps (apps/api, apps/ai,
# apps/web) load this one file — see each app's config.py / next.config.ts for how.
# Never commit the real `.env` (see .gitignore). This is for local dev only — the
# container/production template is infra/.env.example (docker-compose, different hostnames).

# ── API (torii_api, TORII_ prefix) ──────────────────────────────────────────────
TORII_LOG_LEVEL=INFO
# SQLite by default (zero-setup — creates apps/api/torii.db); point at Postgres to switch.
TORII_DATABASE_URL=sqlite:///./torii.db
TORII_MIGRATE_ON_STARTUP=false
TORII_SEED_ON_STARTUP=false
# arq queue + cron broker — run `docker run --rm -p 6379:6379 redis:7-alpine` locally.
TORII_REDIS_URL=redis://localhost:6379/0
TORII_OUTBOX_POLL_INTERVAL_SECONDS=10
TORII_RENEWAL_REMINDER_LEAD_DAYS=30
# Dev-only default; set a strong random value in production.
TORII_JWT_SECRET_KEY=dev-only-change-me-in-production
TORII_JWT_ALGORITHM=HS256
TORII_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080
TORII_EMAIL_VERIFICATION_TOKEN_EXPIRE_MINUTES=1440
TORII_PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60
# Leave TORII_SMTP_HOST empty to disable email sending (logs the link in dev).
TORII_SMTP_HOST=
TORII_SMTP_PORT=587
TORII_SMTP_USER=
TORII_SMTP_PASSWORD=
TORII_SMTP_FROM_EMAIL=noreply@torii.app
TORII_SMTP_FROM_NAME=Torii
TORII_SMTP_TLS=true
TORII_APP_BASE_URL=http://localhost:3000
TORII_AI_SERVICE_URL=http://localhost:8001
TORII_SCRAPE_JURISDICTIONS=JP,US
TORII_SERVICE_TOKEN=
TORII_JURISDICTIONS_DIR=
TORII_REQUIRE_PACKET_ENTITLEMENT=true

# ── AI service (torii_ai, TORII_AI_ prefix) ─────────────────────────────────────
TORII_AI_LOG_LEVEL=INFO
TORII_AI_DOCS_ENABLED=true

# Groq (OpenAI-compatible). Groq retires model names on its own schedule — check
# https://console.groq.com/docs/models when a call starts answering 404 model_not_found.
TORII_AI_GROQ_API_KEY=
TORII_AI_GROQ_MODEL=qwen/qwen3.8-27b
TORII_AI_GROQ_EXTRACT_MODEL=openai/gpt-oss-120b
TORII_AI_GROQ_BASE_URL=https://api.groq.com/openai/v1
TORII_AI_GROQ_TIMEOUT_SECONDS=60.0
TORII_AI_GROQ_MAX_TOKENS=8000

# NVIDIA NIM (OpenAI-compatible) — preferred when set, falls back to Groq, then a fake client.
TORII_AI_NVIDIA_API_KEY=
TORII_AI_NVIDIA_MODEL=openai/gpt-oss-120b
TORII_AI_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
TORII_AI_NVIDIA_MAX_TOKENS=4096
TORII_AI_NVIDIA_TIMEOUT_SECONDS=120.0

# Tavily search
TORII_AI_TAVILY_API_KEY=
TORII_AI_TAVILY_TIMEOUT_SECONDS=20.0
TORII_AI_TAVILY_MAX_RESULTS=5
TORII_AI_TAVILY_INCLUDE_DOMAINS=isa.go.jp,moj.go.jp,gov,go.jp

# Scraper budget
TORII_AI_SCRAPE_MAX_PAGES=6
TORII_AI_SCRAPE_PAGE_CHARS=2500

# System of record (torii_api)
TORII_AI_API_BASE_URL=http://localhost:8000
TORII_AI_SERVICE_TOKEN=
TORII_AI_API_TIMEOUT_SECONDS=10.0
TORII_AI_COOKIE_SECURE=false

# ── Web (apps/web, Next.js — read via next.config.ts's root env loader) ────────
# Dev-only proxy targets for /backend/* and /assistant/* rewrites; defaults already match
# these values, only needed if either service runs on a non-default host/port.
API_PROXY_TARGET=http://localhost:8000
AI_PROXY_TARGET=http://localhost:8001

Local accounts
Applicant: applicant1@example.com / applicant-pass-123
Admin: admin@example.com / admin-pass-123
Ops: ops@example.com / ops-pass-123
Employer: employer@example.com / employer-pass-123
